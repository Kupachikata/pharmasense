# Copy to .env and change the passwords. Never commit .env.
APP_ENV=dev

# PostgreSQL superuser (docker only; used once to create roles and the database)
POSTGRES_PASSWORD=change-me-superuser
# Schema owner: runs Alembic migrations
PHARMASENSE_OWNER_PASSWORD=change-me-owner
# Application role used by the API (no UPDATE/DELETE on audit tables)
PHARMASENSE_APP_PASSWORD=change-me-app

# Host ports (docker compose)
DB_PORT=5432
API_PORT=8000
WEB_PORT=8080

# For running the API or tests outside docker against a local database
DATABASE_URL=postgresql+psycopg://pharmasense_app:change-me-app@localhost:5432/pharmasense
MIGRATION_DATABASE_URL=postgresql+psycopg://pharmasense_owner:change-me-owner@localhost:5432/pharmasense
